
1. Gate-Level (Structural) Modeling

module xor_gate_level (a,b,y);
 input a;
 input b;
 output y;
 xor (y, a, b);
endmodule


2. Dataflow Modeling

module xor_dataflow (a,b,y);
 input a;
 input b;
 output y;
 assign y = a ^b;
endmodule


3. BehavioralModeling

module xor_behavioural(a,b,y);
 input a;
 input b;
 output y;
 output reg y;
 always @(a or b)
begin
 if (a = = b)
 y = 1'b0;
 else
 y = 1'b1;
 end
endmodule
