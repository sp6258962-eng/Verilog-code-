
1. Gate-Level (Structural) Modeling

module or_gate_level (a,b,y);
 input a;
 input b;
 output y;
 or (y, a, b);
endmodule


2. Dataflow Modeling

module or_dataflow (a,b,y);
 input a;
 input b;
 output y;
 assign y = a | b;
endmodule


3. BehavioralModeling

module or_behavioural(a,b,y);
 input a;
 input b;
 output y;
 reg y;
 always @(a or b)
begin
 if (a == 1'b0 && b == 1'b0)
 y = 1'b0;
 else
 y = 1'b1;
 end
endmodule
