
1. Gate-Level (Structural) Modeling

module and_gate_level (a,b,y);
 input a;
 input b;
 output y;
 and (y, a, b);
endmodule


2. Dataflow Modeling

module and_dataflow (a,b,y);
 input a;
 input b;
 output y;
 assign y = a & b;
endmodule


3. BehavioralModeling

module and_behavioural(a,b,y);
 input a;
 input b;
 output y;
 reg y ;
 always @(a or b)
begin
 if (a = = 1'b1 && b = = 1'b1)
 y = 1'b1;
 else
 y = 1'b0;
 end
endmodule
